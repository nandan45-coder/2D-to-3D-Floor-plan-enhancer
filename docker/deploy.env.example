# Settings for the Docker setup (docs/DEPLOYMENT.md). Copy this file to docker/deploy.env and fill it in.
# docker/deploy.env holds secrets: it is never committed (.gitignore) and never copied into an image (.dockerignore).
# The database, upload folder and APP_ENV are fixed by docker-compose.yml.
# One setting per line, no quotes, no comments after a value.

# The address people open in the browser (several: separate with commas)
CORS_ORIGINS=http://localhost:8080

# true once the site is served over https:// (the sign-in cookie is then sent over HTTPS only)
SESSION_COOKIE_SECURE=false
SESSION_DAYS=30

# AI assistant: gemini, openai or offline (offline = simple mode, no key needed)
LLM_PROVIDER=offline
LLM_API_KEY=
LLM_MODEL=

# Email for "Forgot password?" codes (Gmail: smtp.gmail.com, port 587, starttls, an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# The interactive API pages (/api/docs) -- off in production
ENABLE_API_DOCS=false
LOG_LEVEL=INFO
